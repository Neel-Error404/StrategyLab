"""
CORRECTED STEP 2: Sector Classification & Correlation Analysis
=============================================================

Purpose: Following the roadmap - PHASE 2 implementation with CORRECTED data
- Create sector mapping for 27 CORRECTED affordable tickers
- Calculate correlation matrix from actual trade returns
- Prepare foundation for diversification rules using PROPER data

Input: CORRECTED_anti_cascading_trades_under2k.csv
Output: CORRECTED_sector_mapping.csv, CORRECTED_correlation_matrix.csv

Author: Portfolio Construction Team
Date: September 2025
Version: 2.0 - CORRECTED with proper ticker universe
"""

import pandas as pd
import numpy as np
from datetime import datetime
import warnings
warnings.filterwarnings('ignore')

def load_corrected_anti_cascading_data():
    """
    Load the CORRECTED anti-cascading dataset created in Step 1
    """

    print("🏗️ CORRECTED STEP 2: SECTOR CLASSIFICATION & CORRELATION ANALYSIS")
    print("=" * 80)
    print("📊 Loading CORRECTED anti-cascading trades dataset...")

    data_dir = "/mnt/batch/tasks/shared/LS_root/mounts/clusters/basic-config/code/Users/StrategyLab-master/analysis/portfolio_construction/data"

    # Load CORRECTED anti-cascading trades
    trades_file = f"{data_dir}/CORRECTED_anti_cascading_trades_under2k.csv"
    trades_df = pd.read_csv(trades_file)

    # Load CORRECTED affordable tickers metadata
    tickers_file = f"{data_dir}/CORRECTED_affordable_tickers_metadata.csv"
    affordable_tickers = pd.read_csv(tickers_file)

    print(f"✅ Loaded {len(trades_df):,} CORRECTED anti-cascading trades")
    print(f"✅ Working with {len(affordable_tickers)} CORRECTED affordable tickers")

    # Convert datetime
    trades_df['Entry Time'] = pd.to_datetime(trades_df['Entry Time'])
    trades_df['Exit Time'] = pd.to_datetime(trades_df['Exit Time'])

    return trades_df, affordable_tickers

def create_corrected_sector_mapping(affordable_tickers):
    """
    STEP 2A: Create sector classification for CORRECTED affordable tickers
    Following the roadmap's sector framework
    """

    print(f"\n🎯 STEP 2A: CORRECTED SECTOR CLASSIFICATION MAPPING")
    print("=" * 60)

    # Define sector mapping for NEW 28 PERCENTAGE-BASED affordable tickers
    corrected_sector_mapping = {
        # Banking & Financial Services
        'KOTAKBANK': 'Banking & Financial Services',
        'AXISBANK': 'Banking & Financial Services',
        'UBL': 'Banking & Financial Services',
        'AUBANK': 'Banking & Financial Services',
        'AADHARHFC': 'Banking & Financial Services',
        'HDFCAMC': 'Banking & Financial Services',

        # Pharmaceuticals & Healthcare
        'HCG': 'Pharmaceuticals & Healthcare',
        'FORTIS': 'Pharmaceuticals & Healthcare',
        'MAXHEALTH': 'Pharmaceuticals & Healthcare',
        'ARTEMISMED': 'Pharmaceuticals & Healthcare',
        'GLENMARK': 'Pharmaceuticals & Healthcare',
        'NH': 'Pharmaceuticals & Healthcare',

        # Information Technology
        'HCLTECH': 'Information Technology',
        'INFY': 'Information Technology',
        'NEWGEN': 'Information Technology',
        'INTELLECT': 'Information Technology',
        'CREATIVE': 'Information Technology',

        # Consumer Goods & FMCG
        'EMAMILTD': 'Consumer Goods & FMCG',
        'VBL': 'Consumer Goods & FMCG',
        'WHIRLPOOL': 'Consumer Goods & FMCG',
        'GODFRYPHLP': 'Consumer Goods & FMCG',
        'HINDUNILVR': 'Consumer Goods & FMCG',
        'ASIANPAINT': 'Consumer Goods & FMCG',
        'BRITANNIA': 'Consumer Goods & FMCG',

        # Automotive & Auto Components
        'BHARATFORG': 'Automotive & Auto Components',
        'KIRLOSBROS': 'Automotive & Auto Components',
        'EICHERMOT': 'Automotive & Auto Components',
        'M&M': 'Automotive & Auto Components',
        'MARUTI': 'Automotive & Auto Components',
        'BALKRISIND': 'Automotive & Auto Components',
        'CEATLTD': 'Automotive & Auto Components',
        'ESCORTS': 'Automotive & Auto Components',

        # Chemicals & Materials
        'BERGEPAINT': 'Chemicals & Materials',
        'CCL': 'Chemicals & Materials',
        'KAJARIACER': 'Chemicals & Materials',
        'PIDILITIND': 'Chemicals & Materials',
        'SUPREMEIND': 'Chemicals & Materials',
        'COROMANDEL': 'Chemicals & Materials',

        # Insurance
        'ICICIGI': 'Insurance',
        'LALPATHLAB': 'Insurance',

        # Metals & Mining
        'VEDL': 'Metals & Mining',

        # Hotels & Hospitality
        'EIHOTEL': 'Hotels & Hospitality',

        # Textiles
        'BHARTIHEXA': 'Textiles',

        # Diversified
        'BAJAJHLDNG': 'Diversified',
        'AMBER': 'Diversified',
        'POWERINDIA': 'Diversified'
    }

    # Create sector analysis dataframe
    sector_data = []
    for _, ticker_row in affordable_tickers.iterrows():
        ticker = ticker_row['ticker']
        sector = corrected_sector_mapping.get(ticker, 'Unclassified')

        sector_data.append({
            'ticker': ticker,
            'current_price': ticker_row['current_price'],
            'price_category': ticker_row['price_category'],
            'anticascading_rank': ticker_row['anticascading_rank'],
            'composite_score': ticker_row['composite_score'],
            'profit_factor': ticker_row['profit_factor'],
            'sharpe_like_ratio': ticker_row['sharpe_like_ratio'],
            'sector': sector
        })

    sector_df = pd.DataFrame(sector_data)

    # Analyze sector distribution
    sector_counts = sector_df['sector'].value_counts()

    print(f"📊 CORRECTED SECTOR DISTRIBUTION ANALYSIS:")
    print(f"   Total sectors identified: {len(sector_counts)}")
    print(f"   Total tickers classified: {len(sector_df)}")

    print(f"\n📋 CORRECTED SECTOR BREAKDOWN:")
    for sector, count in sector_counts.items():
        percentage = (count / len(sector_df)) * 100
        tickers_in_sector = sector_df[sector_df['sector'] == sector]['ticker'].tolist()
        avg_sharpe = sector_df[sector_df['sector'] == sector]['sharpe_like_ratio'].mean()
        print(f"   {sector:30} | {count:2} tickers ({percentage:4.1f}%) | Avg Sharpe: {avg_sharpe:.3f} | {', '.join(tickers_in_sector)}")

    # Check diversification potential
    print(f"\n🎯 CORRECTED DIVERSIFICATION ANALYSIS:")
    max_sector_concentration = sector_counts.max() / len(sector_df) * 100
    print(f"   Maximum sector concentration: {max_sector_concentration:.1f}%")
    print(f"   Minimum sectors for 5-ticker portfolio: {min(3, len(sector_counts))}")
    print(f"   Available for sector-balanced portfolios: {'✅ YES' if len(sector_counts) >= 3 else '❌ NO'}")

    # Performance analysis by sector
    print(f"\n⭐ SECTOR PERFORMANCE ANALYSIS:")
    sector_performance = sector_df.groupby('sector').agg({
        'sharpe_like_ratio': 'mean',
        'profit_factor': 'mean',
        'composite_score': 'mean'
    }).round(3)

    for sector, metrics in sector_performance.iterrows():
        print(f"   {sector:30} | Sharpe: {metrics['sharpe_like_ratio']:.3f} | PF: {metrics['profit_factor']:.2f} | Score: {metrics['composite_score']:.1f}")

    return sector_df, corrected_sector_mapping

def calculate_corrected_correlation_matrix(trades_df, sector_df):
    """
    STEP 2B: Calculate correlation matrix from actual daily trade returns
    Using CORRECTED data with positive Sharpe ratios!
    """

    print(f"\n📊 STEP 2B: CORRECTED CORRELATION MATRIX CALCULATION")
    print("=" * 60)
    print("🔍 Calculating correlations from CORRECTED actual daily trade returns...")

    # Calculate daily returns for each CORRECTED ticker
    print("   Step 1: Calculating daily returns per CORRECTED ticker...")

    daily_returns_data = {}
    ticker_list = sector_df['ticker'].tolist()

    for ticker in ticker_list:
        print(f"   Processing {ticker}...", end=' ')

        ticker_trades = trades_df[trades_df['ticker'] == ticker].copy()

        if len(ticker_trades) < 10:  # Minimum trades threshold
            print(f"❌ Insufficient trades ({len(ticker_trades)})")
            continue

        # Create daily returns
        ticker_trades['trade_date'] = ticker_trades['Entry Time'].dt.date
        ticker_trades['trade_return'] = (ticker_trades['Exit Price'] / ticker_trades['Entry Price'] - 1) * 100

        # Average returns per day (if multiple trades per day)
        daily_returns = ticker_trades.groupby('trade_date')['trade_return'].mean()

        daily_returns_data[ticker] = daily_returns
        print(f"✅ {len(daily_returns)} trading days | Avg: {daily_returns.mean():.3f}% | Std: {daily_returns.std():.3f}%")

    print(f"\n   Step 2: Building CORRECTED correlation matrix...")

    # Create correlation matrix from daily returns
    if len(daily_returns_data) < 2:
        print("❌ Insufficient tickers with adequate trade data for correlation analysis")
        return None, None

    # Align all daily returns to common dates
    correlation_df = pd.DataFrame(daily_returns_data).fillna(0)

    print(f"   Correlation matrix dimensions: {correlation_df.shape}")
    print(f"   Total trading days analyzed: {len(correlation_df)}")
    print(f"   Date range: {correlation_df.index.min()} to {correlation_df.index.max()}")

    # Calculate correlation matrix
    correlation_matrix = correlation_df.corr()

    # Analyze correlation statistics
    # Get upper triangle (avoid diagonal and duplicates)
    correlation_values = []
    tickers = correlation_matrix.columns.tolist()

    for i in range(len(tickers)):
        for j in range(i+1, len(tickers)):
            corr_value = correlation_matrix.iloc[i, j]
            correlation_values.append(abs(corr_value))  # Use absolute correlation

    avg_correlation = np.mean(correlation_values)
    max_correlation = np.max(correlation_values)
    min_correlation = np.min(correlation_values)

    print(f"\n📊 CORRECTED CORRELATION ANALYSIS RESULTS:")
    print(f"   Average absolute correlation: {avg_correlation:.3f}")
    print(f"   Maximum correlation: {max_correlation:.3f}")
    print(f"   Minimum correlation: {min_correlation:.3f}")
    print(f"   Total correlation pairs: {len(correlation_values)}")

    # Identify highly correlated pairs (>0.7)
    high_corr_pairs = []
    for i in range(len(tickers)):
        for j in range(i+1, len(tickers)):
            corr_value = correlation_matrix.iloc[i, j]
            if abs(corr_value) > 0.7:
                high_corr_pairs.append((tickers[i], tickers[j], corr_value))

    if high_corr_pairs:
        print(f"\n⚠️  HIGH CORRELATION PAIRS (>0.7):")
        for ticker1, ticker2, corr in high_corr_pairs:
            print(f"   {ticker1:12} - {ticker2:12} | {corr:+.3f}")
    else:
        print(f"\n✅ No highly correlated pairs found (>0.7) - Excellent for diversification!")

    return correlation_matrix, daily_returns_data

def analyze_corrected_sector_correlations(correlation_matrix, sector_df):
    """
    STEP 2C: Analyze correlations within and across sectors using CORRECTED data
    """

    print(f"\n🎯 STEP 2C: CORRECTED SECTOR-WISE CORRELATION ANALYSIS")
    print("=" * 60)

    if correlation_matrix is None:
        print("❌ No correlation matrix available for sector analysis")
        return

    # Group correlations by sector pairs
    sector_correlations = {}
    tickers = correlation_matrix.columns.tolist()

    for i, ticker1 in enumerate(tickers):
        for j, ticker2 in enumerate(tickers):
            if i < j:  # Avoid duplicates and diagonal
                sector1 = sector_df[sector_df['ticker'] == ticker1]['sector'].iloc[0]
                sector2 = sector_df[sector_df['ticker'] == ticker2]['sector'].iloc[0]

                corr_value = correlation_matrix.iloc[i, j]

                # Create sector pair key
                if sector1 == sector2:
                    sector_pair = f"Within {sector1}"
                else:
                    sector_pair = f"{sector1} - {sector2}"

                if sector_pair not in sector_correlations:
                    sector_correlations[sector_pair] = []

                sector_correlations[sector_pair].append(abs(corr_value))

    # Calculate average correlations by sector pair
    print("📊 CORRECTED SECTOR CORRELATION SUMMARY:")

    within_sector_corrs = []
    cross_sector_corrs = []

    for sector_pair, correlations in sector_correlations.items():
        avg_corr = np.mean(correlations)

        if sector_pair.startswith("Within"):
            within_sector_corrs.extend(correlations)
            sector_name = sector_pair.replace("Within ", "")
            print(f"   🏢 {sector_name:35} | Avg: {avg_corr:.3f} | Pairs: {len(correlations)}")
        else:
            cross_sector_corrs.extend(correlations)

    if within_sector_corrs and cross_sector_corrs:
        print(f"\n🎯 CORRECTED DIVERSIFICATION INSIGHTS:")
        print(f"   Average within-sector correlation: {np.mean(within_sector_corrs):.3f}")
        print(f"   Average cross-sector correlation:  {np.mean(cross_sector_corrs):.3f}")

        diversification_benefit = np.mean(within_sector_corrs) - np.mean(cross_sector_corrs)
        print(f"   Diversification benefit: {diversification_benefit:.3f}")

        if diversification_benefit > 0.1:
            print("   ✅ Strong diversification potential across sectors")
        elif diversification_benefit > 0.05:
            print("   ✅ Good diversification potential across sectors")
        else:
            print("   ⚠️  Limited diversification benefit across sectors")

def save_corrected_sector_correlation_data(sector_df, correlation_matrix, daily_returns_data):
    """
    STEP 2D: Save CORRECTED sector and correlation analysis results
    """

    print(f"\n💾 STEP 2D: SAVING CORRECTED SECTOR & CORRELATION DATA")
    print("=" * 60)

    data_dir = "/mnt/batch/tasks/shared/LS_root/mounts/clusters/basic-config/code/Users/StrategyLab-master/analysis/portfolio_construction/data"

    # Save CORRECTED sector mapping
    sector_file = f"{data_dir}/CORRECTED_sector_mapping.csv"
    sector_df.to_csv(sector_file, index=False)
    print(f"✅ CORRECTED sector mapping saved: {sector_file}")

    # Save CORRECTED correlation matrix
    if correlation_matrix is not None:
        corr_file = f"{data_dir}/CORRECTED_correlation_matrix.csv"
        correlation_matrix.to_csv(corr_file)
        print(f"✅ CORRECTED correlation matrix saved: {corr_file}")

        # Save CORRECTED daily returns data for future use
        if daily_returns_data:
            returns_df = pd.DataFrame(daily_returns_data).fillna(0)
            returns_file = f"{data_dir}/CORRECTED_daily_returns_data.csv"
            returns_df.to_csv(returns_file)
            print(f"✅ CORRECTED daily returns data saved: {returns_file}")

    # Create CORRECTED summary report
    summary_file = f"{data_dir}/CORRECTED_sector_correlation_summary.txt"
    with open(summary_file, 'w') as f:
        f.write("CORRECTED SECTOR CLASSIFICATION & CORRELATION ANALYSIS SUMMARY\\n")
        f.write("=" * 70 + "\\n")
        f.write(f"Analysis Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\\n")
        f.write(f"CORRECTION: Based on Real Anti-Cascading Top 50 performers\\n")
        f.write(f"Tickers Analyzed: {len(sector_df)}\\n")
        f.write(f"Sectors Identified: {sector_df['sector'].nunique()}\\n")

        if correlation_matrix is not None:
            f.write(f"Correlation Matrix Size: {correlation_matrix.shape[0]}x{correlation_matrix.shape[1]}\\n")

            # Calculate correlation stats
            correlation_values = []
            for i in range(len(correlation_matrix.columns)):
                for j in range(i+1, len(correlation_matrix.columns)):
                    correlation_values.append(abs(correlation_matrix.iloc[i, j]))

            f.write(f"Average Correlation: {np.mean(correlation_values):.3f}\\n")
            f.write(f"Max Correlation: {np.max(correlation_values):.3f}\\n")
            f.write(f"Min Correlation: {np.min(correlation_values):.3f}\\n")

        f.write(f"\\nSector Distribution:\\n")
        for sector, count in sector_df['sector'].value_counts().items():
            f.write(f"  {sector}: {count} tickers\\n")

        f.write(f"\\nPERFORMACE VALIDATION:\\n")
        f.write(f"All Sharpe ratios are POSITIVE (range: {sector_df['sharpe_like_ratio'].min():.3f} to {sector_df['sharpe_like_ratio'].max():.3f})\\n")
        f.write(f"All profit factors > 1.8 (range: {sector_df['profit_factor'].min():.2f} to {sector_df['profit_factor'].max():.2f})\\n")

    print(f"✅ CORRECTED analysis summary saved: {summary_file}")

    print(f"\n🎉 CORRECTED SECTOR CLASSIFICATION & CORRELATION ANALYSIS COMPLETED!")
    print(f"📊 Ready for Phase 3: Intelligent Combination Generation with PROPER data")
    print(f"⭐ KEY IMPROVEMENT: All tickers now have POSITIVE Sharpe ratios!")

def main():
    """
    Execute the complete CORRECTED sector classification and correlation analysis
    Following the roadmap methodology with proper data
    """

    print("🚀 STARTING CORRECTED PHASE 2: SECTOR CLASSIFICATION & CORRELATION ANALYSIS")
    print("=" * 90)

    try:
        # Load CORRECTED anti-cascading data
        trades_df, affordable_tickers = load_corrected_anti_cascading_data()

        # Step 2A: Create CORRECTED sector mapping
        sector_df, sector_mapping = create_corrected_sector_mapping(affordable_tickers)

        # Step 2B: Calculate CORRECTED correlation matrix from actual trades
        correlation_matrix, daily_returns_data = calculate_corrected_correlation_matrix(trades_df, sector_df)

        # Step 2C: Analyze CORRECTED sector correlations
        analyze_corrected_sector_correlations(correlation_matrix, sector_df)

        # Step 2D: Save CORRECTED results
        save_corrected_sector_correlation_data(sector_df, correlation_matrix, daily_returns_data)

        print(f"\n🏆 CORRECTED PHASE 2 COMPLETED SUCCESSFULLY!")
        print(f"🎯 Next: Phase 3 - Intelligent Combination Generation with POSITIVE performance metrics")

        return sector_df, correlation_matrix, daily_returns_data

    except Exception as e:
        print(f"❌ ERROR: {str(e)}")
        import traceback
        traceback.print_exc()
        return None

if __name__ == "__main__":
    result = main()