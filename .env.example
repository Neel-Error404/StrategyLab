# ================================
# StrategyLab Backtester Configuration
# ================================
# Copy this file to .env and fill in your actual credentials
#
# ⚠️ CRITICAL SECURITY WARNING ⚠️
# ================================
# 1. NEVER commit your .env file to version control
# 2. The .env file contains sensitive API credentials
# 3. .gitignore is configured to exclude .env files
# 4. If credentials are accidentally committed, ROTATE them immediately
# 5. Never share your .env file or paste credentials in chats/issues
#
# Setup Guide: docs/BROKER_SETUP.md
# ================================

# ================================
# BROKER API CREDENTIALS
# ================================
# You need ONLY ONE broker configured for basic operation.
# Choose Upstox (recommended for beginners) OR Zerodha.

# --- Upstox API (Recommended) ---
# Get your credentials from: https://developer.upstox.com/
# Free tier available with limitations
UPSTOX_CLIENT_ID=your_upstox_client_id_here
UPSTOX_CLIENT_SECRET=your_upstox_client_secret_here
UPSTOX_REDIRECT_URI=https://127.0.0.1:5000/

# --- Zerodha Kite API ---
# Get your credentials from: https://kite.trade/
# Requires paid subscription
# ZERODHA_API_KEY=your_zerodha_api_key_here
# ZERODHA_API_SECRET=your_zerodha_api_secret_here
# ZERODHA_USER_ID=your_user_id_here

# --- Binance API (Crypto - FREE, Easiest to Start) ---
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# Registration is free, no subscription fees
# BINANCE_API_KEY=your_binance_api_key_here
# BINANCE_API_SECRET=your_binance_secret_here

# --- Flattrade API (Alternative) ---
# Uncomment if using Flattrade as your broker
# FLATTRADE_CLIENT_ID=your_flattrade_client_id_here
# FLATTRADE_CLIENT_SECRET=your_flattrade_client_secret_here

# ================================
# DATA PROVIDER CONFIGURATION
# ================================
# Which broker to use for fetching market data
# Options: upstox, zerodha, flattrade
DATA_PROVIDER=upstox

# Default timeframes to fetch (comma-separated)
# Options: 1minute, 5minute, 15minute, 30minute, 1hour, 1day
DEFAULT_TIMEFRAMES=1minute,5minute,15minute

# Number of days of historical data to fetch by default
DEFAULT_HISTORY_DAYS=90

# ================================
# SYSTEM CONFIGURATION
# ================================

# Logging level
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Trading environment
# Options: development, staging, production
# NOTE: Use 'development' for backtesting and learning
TRADING_ENV=development

# Maximum parallel workers for multi-core processing
# Set to 0 for auto-detect, or specify number of cores
MAX_WORKERS=0

# Enable/disable detailed performance profiling
# Set to true for development, false for production
ENABLE_PROFILING=false

# ================================
# DATA STORAGE PATHS
# ================================
# Leave these as default unless you have specific requirements

# Base directory for all data pools
# DATA_POOLS_BASE_PATH=data/pools

# Base directory for backtesting outputs
# OUTPUTS_BASE_PATH=outputs

# Base directory for logs
# LOGS_BASE_PATH=logs

# ================================
# RISK MANAGEMENT DEFAULTS
# ================================
# These can be overridden by templates or command-line arguments

# Default maximum position size as percentage of portfolio
# DEFAULT_MAX_POSITION_SIZE=0.15

# Default stop loss percentage
# DEFAULT_STOP_LOSS_PCT=0.02

# Default portfolio-level risk limit
# DEFAULT_PORTFOLIO_RISK=0.30

# ================================
# OPTIONAL: DATABASE CONFIGURATION
# ================================
# Uncomment and configure if using database for trade storage
# (Not required for basic backtesting)

# DATABASE_URL=postgresql://user:password@localhost:5432/trading_db
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10

# ================================
# OPTIONAL: NOTIFICATION SETTINGS
# ================================
# Uncomment to enable email/SMS notifications
# (Advanced feature, not required for backtesting)

# ENABLE_NOTIFICATIONS=false
# EMAIL_SMTP_SERVER=smtp.gmail.com
# EMAIL_SMTP_PORT=587
# EMAIL_FROM=your-email@gmail.com
# EMAIL_PASSWORD=your-app-specific-password
# EMAIL_TO=recipient@example.com

# ================================
# OPTIONAL: ADVANCED FEATURES
# ================================

# Enable backtest-to-live signal parity validation
# ENABLE_SIGNAL_PARITY_CHECK=true

# Cache market data to speed up repeated backtests
# ENABLE_DATA_CACHING=true

# Generate detailed execution reports
# ENABLE_DETAILED_REPORTS=true

# ================================
# DEVELOPMENT & DEBUGGING
# ================================
# These settings are for developers only

# Enable debug mode (verbose logging, no trade execution in live mode)
# DEBUG_MODE=false

# Save intermediate computation steps for debugging
# SAVE_INTERMEDIATE_RESULTS=false

# Enable strict validation (fails on warnings)
# STRICT_VALIDATION=false

# ================================
# END OF CONFIGURATION
# ================================
#
# After filling in your credentials:
# 1. Save this file as .env (remove .example extension)
# 2. Run: python scripts/verify_setup.py
# 3. If verification passes, you're ready to backtest!
#
# For detailed setup instructions, see: docs/BROKER_SETUP.md
# For troubleshooting, see: docs/ERROR_REFERENCE.md
# ================================
